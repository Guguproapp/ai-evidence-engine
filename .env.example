AI_EVIDENCE_DATA_DIR=./data
AI_EVIDENCE_KEY_DIR=./keys
AI_EVIDENCE_HOST=127.0.0.1
AI_EVIDENCE_PORT=8787

# Cloud Run Evidence Explainer. Cloud Run supplies project credentials through
# its service account; never place an API key in this file or frontend code.
GOOGLE_CLOUD_PROJECT=replace-with-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True
GEMINI_MODEL=gemini-2.5-flash
ALLOWED_ORIGINS=https://ai-evidence-engine-gugupro.artistuncle.chatgpt.site

# Development/Test Remote Black Box. Never point this configuration at a
# Production bucket without a separately approved security and retention plan.
EVIDENCE_BUCKET=replace-with-test-bucket
STORAGE_LOCATION=ASIA-EAST1
